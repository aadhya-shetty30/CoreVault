# --- Python / backend --------------------------------------------------
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/.venv*/
backend/venv/
*.pyc

# Uploaded file storage and the standalone lock-demo's scratch file --
# these are runtime output, not source.
backend/storage/*
!backend/storage/.gitkeep
backend/scripts/_lock_demo_target.txt

# --- Node / frontend -----------------------------------------------------
frontend/node_modules/
frontend/dist/

# --- Env files (never commit real secrets/creds) --------------------------
.env
frontend/.env

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
# Additional environment files and secrets
.env.*
!.env.example
frontend/.env.*
!frontend/.env.example

# Local databases
*.db
*.sqlite
*.sqlite3
*-shm
*-wal

# Backup files
*.backup