# Copy this file to ".env" (same directory) and adjust values as needed.
# Read by the backend only (app/config.py) -- there's no docker-compose
# involved any more; Postgres is a Supabase-hosted instance.

# --- Database (Supabase-hosted Postgres) -------------------------------------
# From your Supabase project: click "Connect" -> "Session pooler" (port
# 5432). NOT "Direct connection": that host (db.<ref>.supabase.co) is
# IPv6-only, and networks without IPv6 can't reach it at all. NOT
# "Transaction pooler" either (port 6543 -- meant for serverless/edge
# functions; this app is a long-running server holding persistent
# connections, which is what session mode is for). The session pooler's
# username is "postgres.<project-ref>", not plain "postgres". Copy that URI
# here, replacing "[YOUR-PASSWORD]" with your actual database password, and
# strip the "postgresql://" scheme back down if Supabase gives you a
# different one -- app/config.py appends "+asyncpg" (running app) or
# "+psycopg2" (Alembic, the upload worker pool) to this same value, so it
# must stay a plain "postgresql://" URL with no driver suffix of its own.
#
#   DATABASE_URL=postgresql://postgres.abcdefghijk:your-password-here@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password-here@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase requires SSL on every connection -- true by default. Only set
# this to false if you've pointed DATABASE_URL at a local/non-Supabase
# Postgres that has no SSL configured (e.g. the old docker-compose setup;
# see docker-compose.yml.unused).
DATABASE_SSL=true

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Where uploaded files are written on disk. Relative paths are resolved
# against the directory uvicorn is started from (see README). Unaffected by
# the database move -- file storage is still 100% local.
STORAGE_ROOT=./storage
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
